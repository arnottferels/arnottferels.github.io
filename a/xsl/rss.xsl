<?xml version="1.0" encoding="UTF-8"?><xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform"><xsl:output method="html" encoding="UTF-8" indent="yes"></xsl:output><xsl:template match="/"><html><head><title>RSS Feed</title><style>*{border-sizing:border-box;-webkit-text-size-adjust:100%;line-height:1.75}body{font-family:monospace;padding:20px}table{border-collapse:collapse;width:100%}td,th{border:1px solid #ccc;border-left:none;border-right:none;padding:8px;text-align:left}thead tr{border-bottom:2px solid #000;border-top:2px solid #000}</style></head><body><h1>RSS Feed</h1><p>This is a human-readable version of the RSS feed. Use an RSS reader for full functionality.</p><table><thead><tr><th>title <xsl:text>(</xsl:text><xsl:value-of select="count(rss/channel/item)"></xsl:value-of><xsl:text> total)</xsl:text></th><th>link</th><th>pubDate</th></tr></thead><tbody><xsl:for-each select="rss/channel/item"><tr><td><xsl:value-of select="title"></xsl:value-of></td><td><a href="{link}"><xsl:value-of select="link"></xsl:value-of></a></td><td><xsl:value-of select="pubDate"></xsl:value-of></td></tr></xsl:for-each></tbody></table></body></html></xsl:template></xsl:stylesheet>