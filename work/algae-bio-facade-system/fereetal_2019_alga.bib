@online{fereetal_2019_alga,
  title = {Algae {Bio}-fa{\c c}ade {System}},
  author = {Ferels, Arnott and Charity, Cathleen and Kenny, Oliver},
  url = {https://arnottferels.github.io/work/algae-bio-facade-system/},
  abstract = {This study introduces a new bio-fa{\c c}ade system in Indonesia, bringing innovation to sustainable architecture. The design focuses on mapping, modeling, and simulating the fa{\c c}ade. The algae modules, categorized as Dark, Standard, and Light, adjust to sunlight levels, making the building more comfortable. Simulations show a significant reduction in the Overall Thermal Transfer Value (OTTV) to an impressive 35 W/m2, setting a benchmark for energy efficiency. The project generates 131,460 kWh annually, reducing 295,346.8 grams of CO2 daily. It stands out as a model in sustainable architecture, demonstrating the potential of biophilic design in urban environments.},
  date = {2019-04},
  keywords = {Fa{\c c}ade design,Fa{\c c}ade ideas,Optimization},
  language = {en}
}
